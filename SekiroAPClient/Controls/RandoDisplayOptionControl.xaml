<UserControl x:Class="SekiroAPClient.Controls.RandoDisplayOptionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SekiroAPClient.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="800" 
             x:Name="control">

    <Grid Margin="0,0,0,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="21"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="25"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="&#xE65F;" FontSize="18" FontFamily="{StaticResource FluentIcons}" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,5,0" VerticalAlignment="Center"
                   Visibility="{Binding ElementName=control, Path=IsChecked, Converter={StaticResource BoolToVisConverter}}" HorizontalAlignment="Center"/>
        <TextBlock Text="&#xE653;" FontSize="12" FontFamily="{StaticResource FluentIcons}" Foreground="{StaticResource Danger}" Margin="0,0,5,0" VerticalAlignment="Center"
                   Visibility="{Binding ElementName=control, Path=IsChecked, Converter={StaticResource NotBoolToVisibilityConverter}}" HorizontalAlignment="Center"/>
        <TextBlock Text="{Binding ElementName=control, Path=Text}" Style="{StaticResource SubHeaderTextBlockBlockStyle}" VerticalAlignment="Center"
                   Grid.Row="0" Grid.Column="1" FontSize="14"/>
        <TextBlock Text="{Binding ElementName=control, Path=Description}" Style="{StaticResource FlatTextBlockStyle}" Opacity="0.7"
                   Grid.Row="1" Grid.Column="1" Visibility="{Binding ElementName=control, Path=HasDescription, Converter={StaticResource BoolToVisConverter}}"
                   TextTrimming="CharacterEllipsis" FontSize="12" FontWeight="Light"/>
    </Grid>

</UserControl>
