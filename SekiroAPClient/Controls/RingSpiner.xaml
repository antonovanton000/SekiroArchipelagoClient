<UserControl x:Class="InjustUILibrary.Controls.RingSpiner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:InjustUILibrary.Controls"
             mc:Ignorable="d" 
             x:Name="control"
             Height="40"
             Width="40"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Storyboard x:Key="roateAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="ring" Storyboard.TargetProperty="RenderTransform.(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1.4" BeginTime="0:0:0"/>
        </Storyboard>
    </UserControl.Resources>

    <Path Stroke="{Binding ElementName=control, Path=SpinerColor}"
                  RenderTransformOrigin="0.5,0.5" x:Name="ring"
                  Data="M35,10 A20,20 35 1 0 30,30" Stretch="Fill">
        <Path.Style>
            <Style TargetType="Path">
                <Setter Property="Height" Value="40"/>
                <Setter Property="Width" Value="40"/>
                <Setter Property="StrokeThickness" Value="4"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ElementName=control, Path=IsSmall}" Value="True">
                        <Setter Property="Height" Value="20"/>
                        <Setter Property="Width" Value="20"/>
                        <Setter Property="StrokeThickness" Value="2"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Path.Style>
        <Path.RenderTransform>
            <RotateTransform Angle="0"/>
        </Path.RenderTransform>
    </Path>
    
</UserControl>
