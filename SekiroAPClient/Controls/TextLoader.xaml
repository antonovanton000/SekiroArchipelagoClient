<UserControl x:Class="InjustUILibrary.Controls.TextLoader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:InjustUILibrary.Controls"
             mc:Ignorable="d" 
             x:Name="control"
             Foreground="{DynamicResource PrimaryTextBrushDarker}"
             FontFamily="Segoe UI"
             FontSize="15"
            d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Storyboard x:Key="LoadingAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Duration="0:0:0.01" Storyboard.TargetName="dot1" Storyboard.TargetProperty="Opacity" To="0"/>
            <DoubleAnimation Duration="0:0:0.01" Storyboard.TargetName="dot2" Storyboard.TargetProperty="Opacity" To="0"/>
            <DoubleAnimation Duration="0:0:0.01" Storyboard.TargetName="dot3" Storyboard.TargetProperty="Opacity" To="0"/>

            <DoubleAnimation Duration="0:0:0.3" Storyboard.TargetName="dot1" Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)" From="-8" To="0">
                <DoubleAnimation.EasingFunction>
                    <CubicEase/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Duration="0:0:0.3" Storyboard.TargetName="dot1" Storyboard.TargetProperty="Opacity" From="0" To="1">
                <DoubleAnimation.EasingFunction>
                    <CubicEase/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation BeginTime="0:0:0.3" Duration="0:0:0.3" Storyboard.TargetName="dot2" Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)" From="-8" To="0">
                <DoubleAnimation.EasingFunction>
                    <CubicEase/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation BeginTime="0:0:0.3" Duration="0:0:0.3" Storyboard.TargetName="dot2" Storyboard.TargetProperty="Opacity" From="0" To="1">
                <DoubleAnimation.EasingFunction>
                    <CubicEase/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation BeginTime="0:0:0.6" Duration="0:0:0.3" Storyboard.TargetName="dot3" Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)" From="-8" To="0">
                <DoubleAnimation.EasingFunction>
                    <CubicEase/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation BeginTime="0:0:0.6" Duration="0:0:0.3" Storyboard.TargetName="dot3" Storyboard.TargetProperty="Opacity" From="0" To="1">
                <DoubleAnimation.EasingFunction>
                    <CubicEase/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation BeginTime="0:0:0.9" Duration="0:0:1" Storyboard.TargetName="dot3" Storyboard.TargetProperty="Opacity" From="1" To="1"/>
        </Storyboard>
    </UserControl.Resources>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource LoadingAnimation}"/>
        </EventTrigger>
    </UserControl.Triggers>
    <StackPanel Orientation="Horizontal" DataContext="{Binding ElementName=control}">
        <TextBlock Text="{Binding Text}" Foreground="{Binding Foreground}" FontWeight="{Binding FontWeight}"
                   FontFamily="{Binding FontFamily}" FontSize="{Binding FontSize}"/>
        <TextBlock Text="." Style="{StaticResource FlatTextBlockStyle}" x:Name="dot1" Foreground="{Binding Foreground}" FontWeight="{Binding FontWeight}"
                   FontFamily="{Binding FontFamily}" FontSize="{Binding FontSize}">
            <TextBlock.RenderTransform>
                <TranslateTransform X="0" Y="0"/>
            </TextBlock.RenderTransform>
        </TextBlock>
        <TextBlock Text="." Style="{StaticResource FlatTextBlockStyle}"  x:Name="dot2" Foreground="{Binding Foreground}" FontWeight="{Binding FontWeight}"
                   FontFamily="{Binding FontFamily}" FontSize="{Binding FontSize}">
            <TextBlock.RenderTransform>
                <TranslateTransform X="0" Y="0"/>
            </TextBlock.RenderTransform>
        </TextBlock>
        <TextBlock Text="." Style="{StaticResource FlatTextBlockStyle}"  x:Name="dot3" Foreground="{Binding Foreground}" FontWeight="{Binding FontWeight}"
                   FontFamily="{Binding FontFamily}" FontSize="{Binding FontSize}">
            <TextBlock.RenderTransform>
                <TranslateTransform X="0" Y="0"/>
            </TextBlock.RenderTransform>
        </TextBlock>
    </StackPanel>
</UserControl>
