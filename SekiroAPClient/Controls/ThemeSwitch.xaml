                              StrokeLineJoin="Bevel" Stretch="Uniform" Height="6" Width="6" Margin="-28,-8,0,0" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Path.RenderTransform>
                    </Path>
                    <Path x:Name="star5" Data="M 127,37 L 104,105 L 34,105 L 91,150 L 69,218 L 127,176 L 187,218 L 164,150 L 223,105 L 151,105 L 127,37" Fill="#FEFEFE" 
                              StrokeLineJoin="Bevel" Stretch="Uniform" Height="4" Width="4" Margin="-8,8,0,0" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Path.RenderTransform>
                    </Path>
                    <Path x:Name="moon" Data="F1 M24,24z M0,0z M12,2L11.54,2A1,1,0,0,0,11.1,3.86A5.94,5.94,0,0,1,14,9A6,6,0,0,1,3.93,13.4A1,1,0,0,0,2.28,14.4A10,10,0,1,0,12,2z"                              
                              Fill="#FEFEFE" HorizontalAlignment="Right" Width="19" Height="19" Stretch="Uniform" Margin="3,0" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform/>
