    </UserControl.Resources>
    <Grid>
        <StackPanel Orientation="Horizontal">
            <local:ClippedBorder ClipToBounds="True" x:Name="switchBox" Height="28" Width="53" CornerRadius="15" MouseDown="switchBox_MouseDown"
                                  BorderThickness="0" BorderBrush="{DynamicResource BorderColorBrush}">
                <local:ClippedBorder.Background>
                    <LinearGradientBrush StartPoint="0.5 0" EndPoint="0.5 1">
                        <GradientStop Color="#699dff" Offset="0"/>
                        <GradientStop Color="#87b0ff" Offset="0.25"/>
                        <GradientStop Color="#88b1ff" Offset="0.5"/>
                        <GradientStop Color="#87b0ff" Offset="0.75"/>
                        <GradientStop Color="#699dff" Offset="1"/>
                    </LinearGradientBrush>
                    <!--<LinearGradientBrush StartPoint="0.5 0" EndPoint="0.5 1">
                        <GradientStop Color="#040507" Offset="0"/>
                        <GradientStop Color="#121624" Offset="0.25"/>
                        <GradientStop Color="#131826" Offset="0.5"/>
                        <GradientStop Color="#121624" Offset="0.75"/>
                        <GradientStop Color="#040507" Offset="1"/>
                    </LinearGradientBrush>-->
                </local:ClippedBorder.Background>
                <Grid>
                    <local:ClippedBorder ClipToBounds="True" Height="28" Width="53" CornerRadius="15" x:Name="Clouds" Opacity="1" RenderTransformOrigin="0.5,0.5">
                        <local:ClippedBorder.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </local:ClippedBorder.RenderTransform>
                        <Grid>
                            <Ellipse Width="18" Height="18" Fill="#aecae2" Margin="42,11,-7,-1"/>
                            <Ellipse Width="18" Height="18" Fill="#aecae2" Margin="28,17,7,-7"/>
                            <Ellipse Fill="#aecae2" Margin="17,20,21,-7"/>
                            <Ellipse Fill="#aecae2" Margin="9,24,34,-6"/>

                            <Ellipse Width="18" Height="18" Fill="#ecf8fd" Margin="44,14,-9,-4"/>
                            <Ellipse Width="18" Height="18" Fill="#ecf8fd" Margin="28,20,7,-10"/>
                            <Ellipse Fill="#ecf8fd" Margin="17,23,21,-10"/>
                            <Ellipse Fill="#ecf8fd" Margin="9,26,33,-9"/>
                        </Grid>
                    </local:ClippedBorder>
                    <Border x:Name="sun" Height="18" Width="18" CornerRadius="13" HorizontalAlignment="Left" Margin="4,0,0,0" Background="#f5e429" Opacity="1">
                        <Border.Effect>
                            <DropShadowEffect Color="#FFFFFF" BlurRadius="10" Direction="-1"  Opacity="0.2"/>
                        </Border.Effect>
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Border.RenderTransform>
                    </Border>
                    <Ellipse x:Name="daystar1" Width="3" Height="3" Fill="#DDFEFEFE" Margin="5,0,0,0" RenderTransformOrigin="0.5,0.5" Opacity="1">
                        <Ellipse.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="daystar2" Width="6" Height="6" Fill="#BBFEFEFE" Margin="20,0,0,10" RenderTransformOrigin="0.5,0.5" Opacity="1">
                        <Ellipse.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <Ellipse x:Name="star1" Width="2" Height="2" Fill="#DDFEFEFE" Margin="-35,7,0,0" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="star2" Width="1" Height="1" Fill="#DDFEFEFE" Margin="-12,-6,0,0" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="star3" Width="2" Height="2" Fill="#AAFEFEFE" Margin="1,-13,0,0" Opacity="0" RenderTransformOrigin="0.5,0.5">
