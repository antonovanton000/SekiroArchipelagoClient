<Page x:Class="SekiroAPClient.Views.SplashPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SekiroAPClient.Views"
      xmlns:vm="clr-namespace:SekiroAPClient.ViewModels"      
      xmlns:iuic="clr-namespace:InjustUILibrary.Controls"
      xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
      mc:Ignorable="d" 
      d:DesignHeight="550" d:DesignWidth="800"
      x:Name="page"
      Title="SplashPage">
    <Page.DataContext>
        <vm:SplashViewModel />
    </Page.DataContext>
    <behaviors:Interaction.Triggers>
        <behaviors:EventTrigger EventName="Loaded" SourceObject="{Binding ElementName=page}">
            <behaviors:InvokeCommandAction Command="{Binding AppearingCommand}" />
        </behaviors:EventTrigger>
    </behaviors:Interaction.Triggers>
    <Page.Resources>

    </Page.Resources>
    <Page.Triggers>
        <EventTrigger RoutedEvent="Page.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Page.Triggers>
    <Grid>
        <Grid>
            <Grid.Background>
                <ImageBrush ImageSource="{DynamicResource GrassBackgroundImage}"
                    TileMode="Tile"
                    Viewport="0,0,512,512"
                    ViewportUnits="Absolute"
                    Stretch="Fill"
                    AlignmentX="Left"
                    AlignmentY="Top" />
            </Grid.Background>
            <StackPanel Orientation="Vertical" Margin="0,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="/Images/archipelago_logo.png" Height="120" Margin="-30,-50,0,0"/>
                <Image Source="/Images/sekiro_logo.png" Height="200" Margin="0,0,0,-20"/>
                <iuic:RingSpiner VerticalAlignment="Bottom" Margin="0,20,0,0" SpinerColor="{DynamicResource PrimaryTextBrush}" />
            </StackPanel>
            <TextBlock Text="{Binding Version}" FontFamily="{StaticResource Londrina-Black}" Style="{StaticResource FlatTextBlockStyle}"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
        </Grid>
        <Grid Visibility="{Binding IsError, Converter={StaticResource BoolToVisConverter}}">
            <Grid.Background>
                <ImageBrush ImageSource="{DynamicResource GrassBackgroundImage}"
            TileMode="Tile"
            Viewport="0,0,512,512"
            ViewportUnits="Absolute"
            Stretch="Fill"
            AlignmentX="Left"
            AlignmentY="Top" />
            </Grid.Background>
            <StackPanel Margin="0,80,0,0" Visibility="{Binding IsPipeServerInCorrect, Converter={StaticResource BoolToVisConverter}}">
                <TextBlock FontFamily="{StaticResource Londrina-Regular}" Foreground="{DynamicResource PrimaryTextBrush}"
                    HorizontalAlignment="Center" VerticalAlignment="Top"  FontSize="20" LineHeight="40">
                    <Run Text="❌" FontSize="24" Foreground="{StaticResource Danger}"/>
                    <Run Text=" Application Already Running" FontSize="24"/>
                    <LineBreak/>                    
                    Another instance of Sekiro Archipelago Client is already running.
                    <LineBreak/>                   
                    Please close all other instances of the application and try again.
                    <LineBreak/>                  
                    Only one instance can run at a time.
                </TextBlock>
                <Button Content="Close Client" Style="{StaticResource FlatButtonStylePrimaryNoArrow}" HorizontalAlignment="Center" Margin="0,40,0,0"
                    Command="{Binding CloseAppCommand}"/>
            </StackPanel>
            <StackPanel Margin="0,80,0,0" Visibility="{Binding IsSekiroInjectorDllMissing, Converter={StaticResource BoolToVisConverter}}">
                <TextBlock FontFamily="{StaticResource Londrina-Regular}" Foreground="{DynamicResource PrimaryTextBrush}"
                    HorizontalAlignment="Center" VerticalAlignment="Top"  FontSize="20" LineHeight="40">
                    <Run Text="❌" FontSize="24" Foreground="{StaticResource Danger}"/>
                    <Run Text=" Missing Required Library" FontSize="24"/>
                    <LineBreak/>                    
                    The required file <Run Text=" SekiroInjector.dll " Background="{StaticResource BlueAlpha80}"/> was not found in the client directory.
                    <LineBreak/>                    
                    Please download the latest release of Sekiro Archipelago Client from the official GitHub repository <LineBreak/> and extract all files to the client directory, making sure that <Run Text=" SekiroInjector.dll " Background="{StaticResource BlueAlpha80}"/> is present.
                    <LineBreak/>
                    Then restart Sekiro Archipelago Client.
                </TextBlock>
                <Button Content="Close Client" Style="{StaticResource FlatButtonStylePrimaryNoArrow}" HorizontalAlignment="Center" Margin="0,80,0,0"
                        Command="{Binding CloseAppCommand}"/>
            </StackPanel>
            <StackPanel Margin="0,80,0,0" Visibility="{Binding IsSekiroInjectorDllOutdated, Converter={StaticResource BoolToVisConverter}}">
                <TextBlock FontFamily="{StaticResource Londrina-Regular}" Foreground="{DynamicResource PrimaryTextBrush}"
                    HorizontalAlignment="Center" VerticalAlignment="Top"  FontSize="20" LineHeight="40">
                    <Run Text="❌" FontSize="24" Foreground="{StaticResource Danger}"/>
                    <Run Text=" Outdated Required Library" FontSize="24"/>
                    <LineBreak/>
                    The file <Run Text=" SekiroInjector.dll " Background="{StaticResource BlueAlpha80}"/> in the client directory is outdated.
                    <LineBreak/>
                    Installed version: <Run Text="{Binding SekiroInjectorDllVersion}" Background="{StaticResource BlueAlpha80}"/>
                    <LineBreak/>
                    Required version: <Run Text=" 1.0.6 " Background="{StaticResource BlueAlpha80}"/>
                    <LineBreak/>
                    Please download the latest release of Sekiro Archipelago Client from the official GitHub repository <LineBreak/> and replace <Run Text=" SekiroInjector.dll " Background="{StaticResource BlueAlpha80}"/> with the updated file.
                    <LineBreak/>
                    Then restart Sekiro Archipelago Client.
                </TextBlock>
                <Button Content="Close Client" Style="{StaticResource FlatButtonStylePrimaryNoArrow}" HorizontalAlignment="Center" Margin="0,80,0,0"
                        Command="{Binding CloseAppCommand}"/>
            </StackPanel>
            <StackPanel Margin="0,80,0,0" Visibility="{Binding IsSekiroLocationInCorrect, Converter={StaticResource BoolToVisConverter}}" >
                <TextBlock FontFamily="{StaticResource Londrina-Regular}" Foreground="{DynamicResource PrimaryTextBrush}"
                HorizontalAlignment="Center" VerticalAlignment="Top"  FontSize="20" LineHeight="40">
                <Run Text="❌" FontSize="24" Foreground="{StaticResource Danger}"/>
                <Run Text=" Incorrect Installation Location" FontSize="24"/>
                <LineBreak/>                    
                Sekiro Archipelago Client was started from the wrong directory.
                <LineBreak/>                   
                This application must be placed inside the <Run Text=" randomizerAP " Background="{StaticResource BlueAlpha80}"/> folder, which should be 
                <LineBreak/>                   
                located in the same directory as <Run Text=" sekiro.exe " Background="{StaticResource BlueAlpha80}"/>
                <LineBreak/>                  
                Please move the entire <Run Text=" randomizerAP " Background="{StaticResource BlueAlpha80}"/> folder next to <Run Text=" sekiro.exe " Background="{StaticResource BlueAlpha80}"/>, then restart the client.                   
                <LineBreak/>
                <Run Text="📘" FontSize="20" Foreground="{StaticResource Blue}"/>
                <Run Text=" Installation guide: " />                    
                <Hyperlink Foreground="{StaticResource Blueish}" Click="Hyperlink_Click">https://github.com/antonovanton000/SekiroArchipelagoClient</Hyperlink>
                </TextBlock>
                <Button Content="Close Client" Style="{StaticResource FlatButtonStylePrimaryNoArrow}" HorizontalAlignment="Center" Margin="0,80,0,0"
            Command="{Binding CloseAppCommand}"/>
            </StackPanel>
            <StackPanel Margin="0,80,0,0" Visibility="{Binding IsSekiroDllMissing, Converter={StaticResource BoolToVisConverter}}">
                <TextBlock FontFamily="{StaticResource Londrina-Regular}" Foreground="{DynamicResource PrimaryTextBrush}"
                HorizontalAlignment="Center" VerticalAlignment="Top"  FontSize="20" LineHeight="40">
                <Run Text="❌" FontSize="24" Foreground="{StaticResource Danger}"/>
                <Run Text=" Missing Required Game Library" FontSize="24"/>
                <LineBreak/>                    
                The required file <Run Text=" oo2core_6_win64.dll " Background="{StaticResource BlueAlpha80}"/> was not found in the game directory.
                <LineBreak/>                   
                This file is part of the original Sekiro installation and is required for the game <LineBreak/> and mods to function correctly.
                <LineBreak/>                  
                Please verify your game files through Steam or reinstall the game to restore the missing file.             
                <LineBreak/>
                Then restart Sekiro Archipelago Client.
                </TextBlock>
                <Button Content="Close Client" Style="{StaticResource FlatButtonStylePrimaryNoArrow}" HorizontalAlignment="Center" Margin="0,80,0,0"
                    Command="{Binding CloseAppCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
