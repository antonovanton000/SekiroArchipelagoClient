<Window x:Class="SekiroAPClient.Views.SteamLaunchOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Steam Setup"
        Height="330"
        Width="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Steam Launch Options"
                   FontFamily="{StaticResource LondrinaSolidRegular}"
                   FontSize="28"
                   Foreground="{DynamicResource PrimaryTextBrush}"/>

        <TextBlock Grid.Row="1"
                   Margin="0,14,0,0"
                   TextWrapping="Wrap"
                   FontFamily="{StaticResource LexendDeca}"
                   FontSize="14"
                   Foreground="{DynamicResource PrimaryTextBrush}"
                   Text="On Steam Deck/Linux, start Sekiro from Steam. Open Sekiro Properties, paste this value into Launch Options, then launch the game from Steam."/>

        <TextBox x:Name="LaunchOptionsTextBox"
                 Grid.Row="2"
                 Margin="0,18,0,0"
                 MinHeight="44"
                 TextWrapping="Wrap"
                 IsReadOnly="True"
                 VerticalContentAlignment="Center"
                 FontFamily="Consolas"
                 FontSize="14"
                 Text="WINEDLLOVERRIDES=&quot;dinput8=n,b&quot; %command%"/>

        <TextBlock Grid.Row="3"
                   Margin="0,14,0,0"
                   TextWrapping="Wrap"
                   FontFamily="{StaticResource LexendDeca}"
                   FontSize="13"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   Text="The client will wait for the DLL connection and show Game: Connected when Sekiro starts with the dinput8 override."/>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,24,0,0">
            <Button Content="Copy"
                    Width="110"
                    Height="34"
                    Margin="0,0,10,0"
                    Style="{StaticResource FlatButtonStylePrimaryNoArrow}"
                    Click="CopyButton_Click"/>
            <Button Content="Close"
                    Width="110"
                    Height="34"
                    Style="{StaticResource FlatButtonStylePrimaryNoArrow}"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
