<Page x:Class="SekiroAPClient.Views.DebugPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SekiroAPClient.Views"
      xmlns:vm="clr-namespace:SekiroAPClient.ViewModels"
      xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:icnt="clr-namespace:InjustUILibrary.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="900"      
      x:Name="page"
      Title="DebugPage">
    <Page.DataContext>
        <vm:DebugViewModel />
    </Page.DataContext>
    <Page.Resources>
        <Storyboard x:Key="titleAnimation">
            <DoubleAnimation Storyboard.TargetName="content" Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                         From="-10" To="0" Duration="0:0:0.4"/>
            <DoubleAnimation Storyboard.TargetName="content" Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.4"/>
        </Storyboard>
    </Page.Resources>
    <behaviors:Interaction.Triggers>
        <behaviors:EventTrigger EventName="Loaded" SourceObject="{Binding ElementName=page}">
            <behaviors:InvokeCommandAction Command="{Binding AppearingCommand}" />
        </behaviors:EventTrigger>
    </behaviors:Interaction.Triggers>
    <Page.Triggers>
        <EventTrigger RoutedEvent="Page.Loaded">
            <EventTrigger.Actions>
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
                    </Storyboard>
                </BeginStoryboard>
                <BeginStoryboard Storyboard="{StaticResource titleAnimation}"/>
            </EventTrigger.Actions>
        </EventTrigger>
    </Page.Triggers>
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="{DynamicResource GrassBackgroundImage}"
                TileMode="Tile"
                Viewport="0,0,512,512"
                ViewportUnits="Absolute"
                Stretch="Fill"
                AlignmentX="Left"
                AlignmentY="Top" />
        </Grid.Background>
        <Grid x:Name="content" Margin="20,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="100"/>
                <RowDefinition Height="45"/>
                <RowDefinition Height="70"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="100"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <Grid>
                <TextBlock Text="Log" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Style="{StaticResource SubHeaderTextBlockBlockStyle}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Pipe State:"  VerticalAlignment="Center"
                       Style="{StaticResource FlatTextBlockStyle}" Margin="0,0,5,0"/>
                    <TextBlock VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource FlatTextBlockStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsServerConnected}" Value="True">
                                        <Setter Property="Text" Value="Connected"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsServerConnected}" Value="False">
                                        <Setter Property="Text" Value="Disconnected"/>
                                        <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1">
                <TextBox IsReadOnly="True" IsReadOnlyCaretVisible="False" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         Style="{StaticResource FlatTextBoxStyle}" Height="90" Text="{Binding LogText}" VerticalContentAlignment="Top"
                         VerticalAlignment="Top" TextChanged="TextBox_TextChanged"/>
            </Grid>
            <Grid Grid.Row="2">
                <TextBlock Text="Test Functions" HorizontalAlignment="Left" VerticalAlignment="Center"
                           Style="{StaticResource SubHeaderTextBlockBlockStyle}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <icnt:Switch Text="Enemy AI Disabled" IsChecked="{Binding IsEnemyAiDisabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <icnt:Switch Text="One Hit Kill" IsChecked="{Binding IsOneHitKillEnabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Style="{StaticResource FlatButtonStylePrimaryNoArrow}" Content="Activate Areas Idols" Margin="10,0,0,0"
                            Command="{Binding ActivateAreasIdolsCommand}" Height="32" FontSize="13" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource FlatButtonStylePrimaryNoArrow}" Content="Kill Player" Margin="10,0,0,0"
                            Command="{Binding KillPlayerCommand}" Height="32" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="45"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Item Type" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Style="{StaticResource FlatTextBlockStyle}" />
                <TextBlock Text="Item" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Style="{StaticResource FlatTextBlockStyle}" Grid.Column="1"/>
                <TextBlock Text="Count" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Style="{StaticResource FlatTextBlockStyle}" Grid.Column="2"/>
                <ComboBox Grid.Row="1" Grid.Column="0" Style="{StaticResource ComboBoxFlatStyle}" ItemsSource="{Binding GameItemCategories}"
                          SelectedItem="{Binding SelectedCategory}" Margin="0,0,10,0" DisplayMemberPath="CategoryName" />
                <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource ComboBoxFlatStyle}" DisplayMemberPath="Name"
                          ItemsSource="{Binding SelectedCategory.Items}" SelectedItem="{Binding SelectedItem}" Margin="0,0,10,0"/>
                <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource FlatTextBoxStyle}" Margin="0,0,10,0"
                         Text="{Binding SpawnCount}" Height="32"/>
                <Button Style="{StaticResource FlatButtonStylePrimary}" Content="Spawn" Grid.Row="1" Grid.Column="3" 
                        Command="{Binding SpawnItemCommand}" Height="32" FontSize="13"/>
            </Grid>
            <Grid Grid.Row="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="350"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Small Hint Message" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Style="{StaticResource FlatTextBlockStyle}" />
                <TextBox Grid.Row="1" Grid.Column="0" Style="{StaticResource FlatTextBoxStyle}" Margin="0,0,10,0"
                    Text="{Binding SmallHintText}" Height="32"/>
                <Button Style="{StaticResource FlatButtonStylePrimaryNoArrow}" Content="Show Small Hint" Grid.Row="1" Grid.Column="3" 
                    Command="{Binding ShowSmallHintCommand}" Height="32" FontSize="13"/>
            </Grid>
            <Grid Grid.Row="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="350"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Hint Message" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Style="{StaticResource FlatTextBlockStyle}" />
                <TextBox Grid.Row="1" Grid.Column="0" Style="{StaticResource FlatTextBoxStyle}" Margin="0,0,10,0"
                        Text="{Binding HintText}" TextWrapping="Wrap" VerticalAlignment="Stretch" VerticalContentAlignment="Top" Height="70"
                        AcceptsReturn="True"/>
                <Button Style="{StaticResource FlatButtonStylePrimaryNoArrow}" Content="Show Small Hint" Grid.Row="1" Grid.Column="3" 
                        Command="{Binding ShowHintCommand}" Height="32" FontSize="13" VerticalAlignment="Center"/>
            </Grid>
            <Grid Grid.Row="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Set Event Flag" HorizontalAlignment="Left" VerticalAlignment="Center"
                           Style="{StaticResource FlatTextBlockStyle}" />
                <TextBox Grid.Row="1" Grid.Column="0" Style="{StaticResource FlatTextBoxStyle}" Margin="0,0,10,0"
                        Text="{Binding EventFlagId, Mode=TwoWay}" Height="32"/>
                <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource ComboBoxFlatStyle}" SelectedIndex="{Binding EventFlagValue, Mode=TwoWay}" Margin="0,0,10,0">
                    <ComboBoxItem Content="False"/>
                    <ComboBoxItem Content="True"/>
                </ComboBox>
                <Button Style="{StaticResource FlatButtonStylePrimaryNoArrow}" Content="Set Event Flag" Grid.Row="1" Grid.Column="3" 
                        Command="{Binding SendEventFlagValueCommand}" Height="32" FontSize="13"/>
            </Grid>
        </Grid>
    </Grid>
</Page>
