<Page x:Class="SekiroAPClient.Views.RandomizerOptionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"       
      xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:vm="clr-namespace:SekiroAPClient.ViewModels"
      xmlns:v="clr-namespace:InjustUILibrary.Validation"
      xmlns:icnt="clr-namespace:InjustUILibrary.Controls"
      xmlns:local="clr-namespace:SekiroAPClient.Views"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="900"      
      x:Name="page"      
      Title="AboutPage">
    <Page.DataContext>
        <vm:RandomizerOptionsViewModel />
    </Page.DataContext>
    <behaviors:Interaction.Triggers>
        <behaviors:EventTrigger EventName="Loaded" SourceObject="{Binding ElementName=page}">
            <behaviors:InvokeCommandAction Command="{Binding AppearingCommand}" />
        </behaviors:EventTrigger>
    </behaviors:Interaction.Triggers>
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="{DynamicResource GrassBackgroundImage}"
                TileMode="Tile"
                Viewport="0,0,512,512"
                ViewportUnits="Absolute"
                Stretch="Fill"
                AlignmentX="Left"
                AlignmentY="Top" />
        </Grid.Background>
        <StackPanel x:Name="content" Margin="20,20,20,0">
            <TextBlock Style="{StaticResource HeaderTextBlockBlockStyle}" FontSize="20" Text="Randomizer Options" Margin="0,0,0,20"/>
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Challenge run preset" HorizontalAlignment="Left" VerticalAlignment="Center"
                           Style="{StaticResource FlatTextBlockStyle}" Margin="0,0,0,5"/>
                <ComboBox Style="{StaticResource ComboBoxFlatStyle}" ItemsSource="{Binding Presets}"
                          SelectedItem="{Binding SelectedPreset, Mode=TwoWay}" Margin="0,0,10,0" />
            </StackPanel>
            <StackPanel Visibility="{Binding IsOopsAll, Converter={StaticResource BoolToVisConverter}}">
                <TextBlock Text="Enemy" HorizontalAlignment="Left" VerticalAlignment="Center"
                           Style="{StaticResource FlatTextBlockStyle}" Margin="0,0,0,5"/>
                <ComboBox Style="{StaticResource ComboBoxFlatStyle}" ItemsSource="{Binding EnemiesList}"
                          SelectedItem="{Binding SelectedEnemy, Mode=TwoWay}" Margin="0,0,10,0" />
            </StackPanel>

        </StackPanel>
    </Grid>
</Page>
