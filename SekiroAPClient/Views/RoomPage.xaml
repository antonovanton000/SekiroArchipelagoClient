<Page x:Class="SekiroAPClient.Views.RoomPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SekiroAPClient.Views"
      xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:vm="clr-namespace:SekiroAPClient.ViewModels"
      xmlns:v="clr-namespace:InjustUILibrary.Validation"
      xmlns:icnt="clr-namespace:InjustUILibrary.Controls"
      xmlns:c="clr-namespace:SekiroAPClient.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="900" 
      d:DataContext="{d:DesignInstance Type=vm:RoomViewModel, IsDesignTimeCreatable=False}"
      x:Name="page"      
      Title="RoomInfoPage">
    <Page.Resources>
        <Storyboard x:Key="showNotification">
            <ObjectAnimationUsingKeyFrames BeginTime="0:0:0" Storyboard.TargetName="notification" Storyboard.TargetProperty="(UIElement.Visibility)">
                <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="{x:Static Visibility.Visible}"/>
            </ObjectAnimationUsingKeyFrames>
            <DoubleAnimation Storyboard.TargetName="notification" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="notification" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" From="0.1" To="1" Duration="0:0:0.15"/>
            <DoubleAnimation Storyboard.TargetName="notification" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" From="0.1" To="1" Duration="0:0:0.15"/>
        </Storyboard>
        <Storyboard x:Key="hideNotification">
            <DoubleAnimation Storyboard.TargetName="notification" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="notification" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" From="1" To="0.1" Duration="0:0:0.15"/>
            <DoubleAnimation Storyboard.TargetName="notification" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" From="1" To="0.1" Duration="0:0:0.15"/>
            <ObjectAnimationUsingKeyFrames BeginTime="0:0:0.15" Storyboard.TargetName="notification" Storyboard.TargetProperty="(UIElement.Visibility)">
                <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="{x:Static Visibility.Visible}"/>
            </ObjectAnimationUsingKeyFrames>
        </Storyboard>
    </Page.Resources>
    <behaviors:Interaction.Triggers>
        <behaviors:EventTrigger EventName="Loaded" SourceObject="{Binding ElementName=page}">
            <behaviors:InvokeCommandAction Command="{Binding AppearingCommand}" />
        </behaviors:EventTrigger>
    </behaviors:Interaction.Triggers>
    <Grid ClipToBounds="True">
        <Grid.Background>
            <ImageBrush ImageSource="{DynamicResource GrassBackgroundImage}"
                TileMode="Tile"
                Viewport="0,0,512,512"
                ViewportUnits="Absolute"
                Stretch="Fill"
                AlignmentX="Left"
                AlignmentY="Top" />
        </Grid.Background>
        <Grid x:Name="content">
            <Grid Margin="20,20,20,0"  Visibility="{Binding IsRandomizing, Converter={StaticResource NotBoolToVisibilityConverter}}" d:Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="450">
                        <TextBlock Text="Player: " Style="{StaticResource HeaderTextBlockBlockStyle}" />
                        <TextBlock Text="{Binding CurrentSession.Players.ActivePlayer.Name}" Style="{StaticResource HeaderTextBlockBlockStyle}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <icnt:Switch Text="Notifications"
                                     IsChecked="{Binding ShowNotifications, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Center"
                                     Margin="0,0,10,0"
                                     ChangeStateCommand="{Binding ChangeNotificationStateCommand}" />
                        <Button Style="{StaticResource FlatButtonStylePrimaryNoArrow}"
                                Width="120"                                
                                Content="{Binding OverlayButtonText}"                                
                                Margin="10,0"                                
                                Command="{Binding OpenExternalWindowCommand}"/>
                        <Button Content="{Binding GameActionButtonText}" Style="{StaticResource FlatButtonStylePrimaryNoArrow}" Width="120"
                                Command="{Binding LaunchGameCommand}"
                                Visibility="{Binding ShowGameActionButton, Converter={StaticResource BoolToVisConverter}}" />
                        <TextBlock Text="{Binding GameConnectionStatusText}" Style="{StaticResource HeaderTextBlockBlockStyle}" VerticalAlignment="Center"
                               Margin="10,0,0,0" FontSize="20" Visibility="{Binding ShowGameConnectionStatus, Converter={StaticResource BoolToVisConverter}}" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1">
                    <TabControl Style="{StaticResource FlatTabControlPillsStyle}" Background="Transparent">
                        <TabItem Header="Item Tracker" Style="{StaticResource FlatUnderlineTabItemStyle}">
                            <Grid>
                                <ItemsControl ItemsSource="{Binding KeyItemTracker.KeyItems}" Margin="0,40,0,0" ScrollViewer.CanContentScroll="False"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="150" Width="100" Margin="0,0,10,10">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="1*"/>
                                                    <RowDefinition Height="50"/>
                                                </Grid.RowDefinitions>
                                                <Image Source="{Binding CheckedImageSource}" Stretch="Uniform" Visibility="{Binding IsChecked, Converter={StaticResource BoolToVisConverter}}"
                                                       Margin="5"/>
                                                <Image Source="{Binding UnCheckedImageSource}" Stretch="Uniform" Visibility="{Binding IsChecked, Converter={StaticResource NotBoolToVisibilityConverter}}"
                                                       Margin="5"/>
                                                <Border Background="{DynamicResource AccentBrush}" Height="25" Width="25" CornerRadius="13"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5" BorderBrush="{DynamicResource PrimaryTextBrush}" BorderThickness="2"
                                                        Visibility="{Binding IsChecked, Converter={StaticResource BoolToVisConverter}}">
                                                    <TextBlock FontFamily="{StaticResource FluentIcons}" Text="&#xE65F;" Foreground="{DynamicResource PrimaryTextBrush}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource FlatTextBlockStyle}" FontSize="12" HorizontalAlignment="Center" Grid.Row="1"
                                                        FontFamily="{StaticResource LexendDeca}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                           TextAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Options" Style="{StaticResource FlatUnderlineTabItemStyle}">
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Vertical">
                                    <c:RandoDisplayOptionControl Text="Enemy Randomizer" IsChecked="{Binding State.RoomRandomizerOptions.RandomizeEnemies}"/>
                                    <c:RandoDisplayOptionControl Text="Randomize bosses" IsChecked="{Binding State.RoomRandomizerOptions.RandomizeBosses}"
                                                                 Description="Enemies with boss health bars replace each other" Margin="30,0,0,0"/>
                                    <c:RandoDisplayOptionControl Text="Randomize minibosses" IsChecked="{Binding State.RoomRandomizerOptions.RandomizeMiniBosses}"
                                                                 Description="Enemies with miniboss health bars replace each other" Margin="30,0,0,0"/>
                                    <c:RandoDisplayOptionControl Text="Randomize Headless" IsChecked="{Binding State.RoomRandomizerOptions.RandomizeHeadless}"
                                                                 Description="Headless are also included in miniboss pool and randomized" Margin="30,0,0,0"/>
                                    <c:RandoDisplayOptionControl Text="Randomize regular enemies" IsChecked="{Binding State.RoomRandomizerOptions.RandomizeRegularEnemies}"
                                                                 Description="All other enemies can replace each other" Margin="30,0,0,0"/>
                                    <TextBlock Text="Other Options" Style="{StaticResource SubHeaderTextBlockBlockStyle}" Margin="0,0,0,10" FontSize="14"/>
                                    <c:RandoDisplayOptionControl Text="Death Link" IsChecked="{Binding State.RoomRandomizerOptions.DeathLink}"
                                                                 Description="Every player in the room shares their fate" Margin="30,0,0,0"/>
                                    <c:RandoDisplayOptionControl Text="Death Link on full death" IsChecked="{Binding State.RoomRandomizerOptions.DeathLinkOnFullDeath}"
                                                                 Description="Send Death Link on a full death without resurrection" Margin="30,0,0,0"
                                                                 Visibility="{Binding State.RoomRandomizerOptions.DeathLink, Converter={StaticResource BoolToVisConverter}}"/>
                                    <c:RandoDisplayOptionControl Text="Carpsanity" IsChecked="{Binding State.RoomRandomizerOptions.Carpsanity}"
                                                                 Description="Shuffle treasure carp drops with other items" Margin="30,0,0,0"/>
                                    <c:RandoDisplayOptionControl Text="Additional Region Locks" IsChecked="{Binding State.RoomRandomizerOptions.AdditionalRegionLock}"
                                                                 Description="Use extra region blockers and their related key items" Margin="30,0,0,0"/>

                                    <TextBlock Style="{StaticResource SubHeaderTextBlockBlockStyle}" Margin="50,10,0,10" FontSize="16">
                                        Goal: <Run Text="{Binding State.RoomRandomizerOptions.GoalOptionText, Mode=OneWay}" TextDecorations="Underline"/>
                                    </TextBlock>

                                    <TextBlock Style="{StaticResource SubHeaderTextBlockBlockStyle}" Margin="50,10,0,10" FontSize="16">
                                        Challenge Run: <Run Text="{Binding State.RoomRandomizerOptions.PresetName, Mode=OneWay}" TextDecorations="Underline"/>
                                    </TextBlock>

                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Progression" Style="{StaticResource SubHeaderTextBlockBlockStyle}" FontSize="14" Margin="0,0,0,10"/>
                                    <c:RandoDisplayOptionControl Text="Bosses keep a similar number of total phases" IsChecked="{Binding State.RoomRandomizerOptions.SimilarBossPhases}"
                                                                 Description="For instance, try to prevent any fight from being SSI + Demon of Hatred" Margin="30,0,0,0"/>
                                    <c:RandoDisplayOptionControl Text="Endgame boss phases are considered longer than early ones" IsChecked="{Binding State.RoomRandomizerOptions.BalancedBossPhases}"
                                                                 Description="Try to prevent early bosses from being seriously unfun without scaling" Margin="30,0,0,0"/>
                                    <c:RandoDisplayOptionControl Text="More manageable early roadblocks" IsChecked="{Binding State.RoomRandomizerOptions.SimpleEarlyMinibosses}"
                                                                 Description="Try to prevent early minibosses from being seriously unfun without scaling" Margin="30,0,0,0"/>
                                    <c:RandoDisplayOptionControl Text="Scale up/down enemy health/damage" IsChecked="{Binding State.RoomRandomizerOptions.ScaleEnemies}"
                                                                 Description="Make enemies easier/harder when moved significantly earlier/later" Margin="30,0,0,0"/>
                                    <TextBlock Text="" Style="{StaticResource SubHeaderTextBlockBlockStyle}" FontSize="14" Margin="0,0,0,10"/>

                                    <c:RandoDisplayOptionControl Text="Remove Headless-induced slow walk" IsChecked="{Binding State.RoomRandomizerOptions.HeadlessSlowWalk}"
                                                                 Description="Removes the slow movement effect applied by Headless enemies" Margin="30,0,0,0"/>
                                    <c:RandoDisplayOptionControl Text="Shuffle Skills and Prosthetics Upgades" IsChecked="{Binding State.RoomRandomizerOptions.RandomSkills}"
                                                                 Description="Shuffle all skills within every Esoteric Text" Margin="30,0,0,0"/>
                                    <c:RandoDisplayOptionControl Text="Replace Esoteric Texts with direct sill drops"
                                                                 IsChecked="{Binding State.RoomRandomizerOptions.IsSkillsAsDrops}"
                                                                 Description="Esoteric Texts are replaced with direct skill unlocks."
                                                                 Margin="30,0,0,0" />

                                    <Button Style="{StaticResource FlatTextButtonStyleNoArrow}" Content="Rerandomize run" Foreground="{StaticResource Danger}"
                                            Margin="50,20,0,0" HorizontalAlignment="Center" Command="{Binding ReRandomizeRunCommand}"/>

                                </StackPanel>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Server" Style="{StaticResource FlatUnderlineTabItemStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="250"/>
                                    <RowDefinition Height="1*"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock Text="Log" FontSize="17" Style="{StaticResource FlatTextBlockStyle}" Margin="0,0,0,5" VerticalAlignment="Top"/>
                                    <TextBox IsReadOnly="True" IsReadOnlyCaretVisible="False" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                             Style="{StaticResource FlatTextBoxStyle}" Text="{Binding LogText}" VerticalContentAlignment="Top"
                                             VerticalAlignment="Stretch" TextChanged="TextBox_TextChanged" Margin="0,30,0,10" Background="{DynamicResource LogTextBoxBackgroundBrush}"
                                             Foreground="{DynamicResource LogTextBoxForegroundBrush}"/>
                                </Grid>
                                <StackPanel Grid.Row="2">
                                    <Grid>
                                        <icnt:InputField x:Name="commandInput" Label="Command" Placeholder="Server command" Text="{Binding ServerCommand, Mode=TwoWay}" Margin="0,0,0,0"
                                                         KeyDown="InputField_KeyDown" PreviewKeyDown="InputField_PreviewKeyDown"/>
                                        <Popup PlacementTarget="{Binding ElementName=commandInput}"
                                               Placement="Bottom"
                                               IsOpen="{Binding IsHintAutocompleteOpen}"
                                               AllowsTransparency="True"
                                               StaysOpen="False"
                                               PopupAnimation="Slide">
                                            <Border Width="{Binding ActualWidth, ElementName=commandInput}"
                                                    MaxHeight="240"
                                                    Background="{DynamicResource BackgroundBrush}"
                                                    BorderBrush="{DynamicResource BorderColorBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    Padding="3">
                                                <ListBox x:Name="hintSuggestionsList"
                                                         ItemsSource="{Binding HintSuggestions}"
                                                         SelectedItem="{Binding SelectedHintSuggestion, Mode=TwoWay}"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         Foreground="{DynamicResource PrimaryTextDarkerBrush}"
                                                         FontFamily="{StaticResource LexendDeca}"
                                                         FontSize="15"
                                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                         SelectionChanged="HintSuggestionsList_SelectionChanged"
                                                         PreviewMouseLeftButtonUp="HintSuggestionsList_PreviewMouseLeftButtonUp">
                                                    <ListBox.ItemContainerStyle>
                                                        <Style TargetType="ListBoxItem">
                                                            <Setter Property="Height" Value="32"/>
                                                            <Setter Property="Padding" Value="9,0"/>
                                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextDarkerBrush}"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="ListBoxItem">
                                                                        <Border x:Name="itemBorder"
                                                                                Background="Transparent"
                                                                                CornerRadius="4"
                                                                                Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource AccentBrushLight}"/>
                                                                            </Trigger>
                                                                            <Trigger Property="IsSelected" Value="True">
                                                                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </ListBox.ItemContainerStyle>
                                                </ListBox>
                                            </Border>
                                        </Popup>
                                        <Button Style="{StaticResource FlatButtonStylePrimaryNoArrow}" Content="Send" HorizontalAlignment="Right" Height="48"
                                            Command="{Binding SendCommandCommand}" VerticalAlignment="Bottom" Margin="0,0,1,1" Width="80"/>
                                    </Grid>
                                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" Margin="0,5,0,0">
                                        <Button Content="help" Style="{StaticResource FlatTextButtonStyle}" Margin="0,0,10,0"
                                                Command="{Binding SetDefaultCommandCommand}" CommandParameter="!help"/>
                                        <Button Content="hint" Style="{StaticResource FlatTextButtonStyle}" Margin="0,0,10,0"
                                                Command="{Binding SetDefaultCommandCommand}" CommandParameter="!hint "/>
                                        <Button Content="remaining" Style="{StaticResource FlatTextButtonStyle}" Margin="0,0,10,0"
                                                Command="{Binding SetDefaultCommandCommand}" CommandParameter="!remaining"/>
                                        <Button Content="release" Style="{StaticResource FlatTextButtonStyle}" Margin="0,0,10,0"
                                                Command="{Binding SetDefaultCommandCommand}" CommandParameter="!release"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Debug"
                                 d:Visibility="Visible"
                                 Visibility="{Binding IsDebug, Converter={StaticResource BoolToVisConverter}}"
                                 Style="{StaticResource FlatUnderlineTabItemStyle}">
                            <StackPanel Margin="0,20,0,0">
                                <TextBlock Text="Inspect randomized item locations, verify progression, and create reports for misplaced or incorrect item placements." Style="{StaticResource FlatTextBlockStyle}"
                                           TextWrapping="Wrap"/>
                                <Button Content="Item Tracker"
                                        Style="{StaticResource FlatButtonStylePrimaryNoArrow}"
                                        Width="120"
                                        Command="{Binding OpenItemTrackerCommand}"
                                        Margin="0,10,10,10"
                                        HorizontalAlignment="Left" />
                                <TextBlock Text="Access advanced debugging tools. Monitor game events, grant items, modify Event Flags, control world progression, toggle enemy AI, and activate Sculptor's Idols."
                                           TextWrapping="Wrap"
                                           Style="{StaticResource FlatTextBlockStyle}" />
                                <Button Content="Debug Window"
                                        Style="{StaticResource FlatButtonStylePrimaryNoArrow}"
                                        Width="120"
                                        Command="{Binding OpenDebugPageCommand}"
                                        Margin="0,10,10,10"
                                        HorizontalAlignment="Left" />
                                
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,15,0" Orientation="Horizontal">
                        <TextBlock Text="Death Counter: "
                                   Style="{StaticResource HeaderTextBlockBlockStyle}" />
                        <TextBlock Text="{Binding State.DeathCounter}"
                                   Style="{StaticResource HeaderTextBlockBlockStyle}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />
                    </StackPanel>
                </Grid>

                <ItemsControl ItemsSource="{Binding Notifications}" HorizontalAlignment="Center" VerticalAlignment="Top" Grid.RowSpan="2">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource AccentBrush}"
                                    Height="55"
                                    Width="350"
                                    Margin="0,5,0,0"
                                    CornerRadius="12"
                                    RenderTransformOrigin="0.5 0.5"
                                    Opacity="0">

                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>

                                <Border.Effect>
                                    <DropShadowEffect Opacity="0.5" ShadowDepth="-1" BlurRadius="5"/>
                                </Border.Effect>

                                <Grid>
                    
                                    <TextBlock Text="{Binding Text}" Visibility="{Binding IsItemNotification, Converter={StaticResource NotBoolToVisibilityConverter}}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource NotificationTextBrush}"
                                               FontFamily="{StaticResource LexendDeca}"
                                               VerticalAlignment="Center"
                                               Margin="10"
                                               TextTrimming="CharacterEllipsis"
                                               MaxHeight="40" />


                                    <TextBlock Visibility="{Binding IsItemNotification, Converter={StaticResource BoolToVisConverter}}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource NotificationTextBrush}"
                                               FontFamily="{StaticResource LexendDeca}"
                                               VerticalAlignment="Center"
                                               Margin="10"
                                               TextTrimming="CharacterEllipsis"
                                               MaxHeight="40">  
                                        <Run Text="{Binding Player}" FontWeight="Bold"/>
                                        <Run Foreground="{DynamicResource NotificationMutedTextBrush}"> found </Run>
                                        <Run Text="{Binding Item}" FontWeight="Bold"/>      
                                    </TextBlock>
                                </Grid>

                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                 From="0.1" To="1" Duration="0:0:0.15" />
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                 From="0.1" To="1" Duration="0:0:0.15" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="Unloaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="1" To="0" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                 From="1" To="0.1" Duration="0:0:0.15" />
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                 From="1" To="0.1" Duration="0:0:0.15" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </Grid>
            <Grid Margin="20" Visibility="{Binding IsRandomizing, Converter={StaticResource BoolToVisConverter}}" d:Visibility="Collapsed">
                <Grid Visibility="{Binding HasErrors, Converter={StaticResource NotBoolToVisibilityConverter}}">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <icnt:RingSpiner SpinerColor="{DynamicResource RingSpinnerBrush}" Margin="0,0,0,20" />
                        <TextBlock Text="{Binding RandomizerHelper.Status}" Style="{StaticResource SubHeaderTextBlockBlockStyle}" 
                                   HorizontalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="{Binding RandomizerHelper.ErrorMessage}" Margin="0,0,0,20" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                    <Button Content="Open Log" Style="{StaticResource FlatTextButtonStyleNoArrow}" Command="{Binding ShowLogFileCommand}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
            <Grid Background="#50FFFFFF" Visibility="{Binding IsReconnecting, Converter={StaticResource BoolToVisConverter}}" d:Visibility="Collapsed">
                <icnt:ClippedBorder CornerRadius="15" Width="240" Height="120" Background="{DynamicResource BackgroundBrush}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <icnt:RingSpiner SpinerColor="{DynamicResource RingSpinnerBrush}" Margin="0,0,0,20"/>
                        <TextBlock Text="Reconnecting..." Style="{StaticResource FlatTextBlockStyle}" Foreground="{DynamicResource PrimaryTextDarkerBrush}"/>
                    </StackPanel>
                </icnt:ClippedBorder>
            </Grid>
        </Grid>
    </Grid>
</Page>
