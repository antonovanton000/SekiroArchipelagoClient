<Page x:Class="SekiroAPClient.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"       
      xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:vm="clr-namespace:SekiroAPClient.ViewModels"
      xmlns:v="clr-namespace:InjustUILibrary.Validation"
      xmlns:icnt="clr-namespace:InjustUILibrary.Controls"
      xmlns:local="clr-namespace:SekiroAPClient.Views"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="900"      
      x:Name="page"      
      Title="AboutPage">
    <Page.DataContext>
        <vm:SettingsViewModel />
    </Page.DataContext>
    <behaviors:Interaction.Triggers>
        <behaviors:EventTrigger EventName="Loaded" SourceObject="{Binding ElementName=page}">
            <behaviors:InvokeCommandAction Command="{Binding AppearingCommand}" />
        </behaviors:EventTrigger>
    </behaviors:Interaction.Triggers>
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="{DynamicResource GrassBackgroundImage}"
                TileMode="Tile"
                Viewport="0,0,512,512"
                ViewportUnits="Absolute"
                Stretch="Fill"
                AlignmentX="Left"
                AlignmentY="Top" />
        </Grid.Background>
        <TextBlock Style="{StaticResource FlatTextBlockStyle}" HorizontalAlignment="Right" Margin="0,28,40,0">
            <Run Text="AppVersion:"/>
            <Run Text="{Binding AppVersion, Mode=OneWay}" FontWeight="Bold"/>
        </TextBlock>
        <StackPanel x:Name="content" Margin="20,20,20,0">
            <TextBlock Style="{StaticResource HeaderTextBlockBlockStyle}" FontSize="20" Text="Settings" Margin="0,0,0,20"/>
            <icnt:Switch Text="Debug"
                         IsChecked="{Binding IsDebug, Mode=TwoWay}" />
            <TextBlock TextWrapping="Wrap"
                       Style="{StaticResource FlatTextBlockStyle}"
                       Opacity="0.9"
                       FontSize="12"
                       FontWeight="Light"
                       Margin="0,15,0,15"
                       LineHeight="18">
                <Run>
                    After enabling Debug, debugging features will become available. Don’t be alarmed if various log files start appearing after generation — they are intended to help identify the root cause of issues more easily.
                </Run>
            </TextBlock>
        </StackPanel>
    </Grid>
</Page>
