<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="PrimaryColor">#C9D6D8</Color>
    <Color x:Key="PrimaryLightColor">#6F8792</Color>
    <Color x:Key="PrimaryDarkColor">#11191C</Color>
    <Color x:Key="TextAndIconsColor">#FFFFFF</Color>
    <Color x:Key="AccentColor">#5EA6C8</Color>
    <Color x:Key="AccentColor2">#314369</Color>
    <Color x:Key="AccentColor3">#1B2540</Color>
    <Color x:Key="AccentColorLight">#9CB7D7</Color>
    <Color x:Key="AccentDisabledColor">#556170</Color>
    <Color x:Key="PrimaryTextColor">#B8C6C4</Color>
    <Color x:Key="PrimaryTextDarkerColor">#D4DEDD</Color>
    <Color x:Key="InputFieldLabelColor">#D4DEDD</Color>
    <Color x:Key="SecondaryTextColor">#A7B3B3</Color>
    <Color x:Key="NotificationTextColor">#F4FBFA</Color>
    <Color x:Key="NotificationMutedTextColor">#D7E5E3</Color>
    <Color x:Key="RingSpinnerColor">#7F9397</Color>
    <Color x:Key="LogTextBoxBackgroundColor">#182123</Color>
    <Color x:Key="LogTextBoxForegroundColor">#EAF2F1</Color>
    <Color x:Key="BackgroundColor">#182123</Color>
    <Color x:Key="BackgroundColorDark">#0F1517</Color>
    <Color x:Key="WindowTopBackgroundColor">#000c00</Color>
    <Color x:Key="BorderColor">#3F4B50</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{DynamicResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{DynamicResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{DynamicResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentBrush2" Color="{DynamicResource AccentColor2}"/>
    <SolidColorBrush x:Key="AccentBrush3" Color="{DynamicResource AccentColor3}"/>
    <SolidColorBrush x:Key="AccentBrushLight" Color="{DynamicResource AccentColorLight}"/>
    <SolidColorBrush x:Key="TextAndIconsBrush" Color="{DynamicResource TextAndIconsColor}"/>
    <SolidColorBrush x:Key="AccentBrushDisabled" Color="{DynamicResource AccentDisabledColor}"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{DynamicResource PrimaryTextColor}"/>
    <SolidColorBrush x:Key="PrimaryTextDarkerBrush" Color="{DynamicResource PrimaryTextDarkerColor}"/>
    <SolidColorBrush x:Key="InputFieldLabelBrush" Color="{DynamicResource InputFieldLabelColor}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{DynamicResource SecondaryTextColor}"/>
    <SolidColorBrush x:Key="NotificationTextBrush" Color="{DynamicResource NotificationTextColor}"/>
    <SolidColorBrush x:Key="NotificationMutedTextBrush" Color="{DynamicResource NotificationMutedTextColor}"/>
    <SolidColorBrush x:Key="RingSpinnerBrush" Color="{DynamicResource RingSpinnerColor}"/>
    <SolidColorBrush x:Key="LogTextBoxBackgroundBrush" Color="{DynamicResource LogTextBoxBackgroundColor}"/>
    <SolidColorBrush x:Key="LogTextBoxForegroundBrush" Color="{DynamicResource LogTextBoxForegroundColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderColorBrush" Color="{DynamicResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderDisabledColorBrush" Color="{DynamicResource AccentDisabledColor}"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{DynamicResource BackgroundColor}"/>
    <SolidColorBrush x:Key="BackgroundBrushDark" Color="{DynamicResource BackgroundColorDark}"/>
    <SolidColorBrush x:Key="WindowTopBackgroundBrush" Color="{DynamicResource WindowTopBackgroundColor}"/>
    <LinearGradientBrush x:Key="GradientBackgroundBrush" EndPoint="0,1">
        <GradientStop Color="{DynamicResource BackgroundColor}" Offset="0"/>
        <GradientStop Color="{DynamicResource BackgroundColorDark}" Offset="1"/>
    </LinearGradientBrush>

    <BitmapImage x:Key="HeaderBackgroundImage" UriSource="/Images/ocean-header.dark.png"/>
    <BitmapImage x:Key="GrassBackgroundImage" UriSource="/Images/grass.dark.png"/>
</ResourceDictionary>
